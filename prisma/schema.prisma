generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String
  passwordHash    String?
  whopUserId      String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sessions        Session[]
  projects        Project[]
  generatedContent GeneratedContent[]
  tasks           LaunchTask[]
  competitors     CompetitorRecord[]
  subscription    Subscription?
  paddleCheckoutIntents PaddleCheckoutIntent[]
  usageRecords    UsageRecord[]
  contactMessages ContactMessage[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id               String             @id @default(cuid())
  userId           String
  title            String
  description      String?            @db.VarChar(2000)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedContent GeneratedContent[]
  tasks            LaunchTask[]
  competitors      CompetitorRecord[]

  @@index([userId, updatedAt])
}

model GeneratedContent {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String   @db.VarChar(80)
  title     String   @db.VarChar(180)
  body      String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model LaunchTask {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String   @db.VarChar(180)
  description String?  @db.VarChar(2000)
  dueDate     DateTime?
  priority    String   @default("medium") @db.VarChar(20)
  status      String   @default("todo") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueDate])
  @@index([projectId])
}

model CompetitorRecord {
  id              String   @id @default(cuid())
  userId          String
  projectId       String?
  name            String   @db.VarChar(180)
  url             String?  @db.VarChar(2048)
  observations    String?  @db.VarChar(4000)
  pricingNotes    String?  @db.VarChar(2000)
  researchedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, researchedAt])
  @@index([projectId])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique
  plan                  String   @default("FREE") @db.VarChar(20)
  status                String   @default("FREE") @db.VarChar(30)
  billingProvider       String?  @db.VarChar(20)
  whopMembershipId      String?  @unique
  whopProductId         String?  @db.VarChar(120)
  whopPlanId            String?  @db.VarChar(120)
  paddleSubscriptionId  String?  @unique
  paddleCustomerId      String?  @db.VarChar(80)
  paddlePriceId         String?  @db.VarChar(80)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  lastVerifiedAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status, currentPeriodEnd])
}

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  requestKey  String
  category    String   @db.VarChar(80)
  status      String   @default("PENDING") @db.VarChar(20)
  response    Json?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestKey])
  @@index([userId, status, createdAt])
}

model WebhookEvent {
  id          String   @id
  eventType   String   @db.VarChar(120)
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(254)
  subject   String   @db.VarChar(180)
  message   String   @db.VarChar(6000)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model RateLimitBucket {
  key             String   @id @db.VarChar(220)
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model PaddleCheckoutIntent {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  priceId             String   @db.VarChar(80)
  transactionId       String?  @unique
  paddleSubscriptionId String?  @unique
  createdAt           DateTime @default(now())
  completedAt         DateTime?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
