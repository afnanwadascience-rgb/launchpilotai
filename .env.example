# PostgreSQL connection strings. Replace both placeholders with your own database URLs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# App security and AI. Generate a fresh SESSION_SECRET with at least 32 characters.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Production URL (used for reference and local configuration)
APP_BASE_URL="http://localhost:3000"

# Existing Whop integration. Keep your real values in local .env or Vercel, not here.
WHOP_PRO_CHECKOUT_URL=""
WHOP_COMPANY_API_KEY=""
WHOP_COMPANY_ID=""
WHOP_PRODUCT_ID=""
WHOP_PRO_PLAN_ID=""
WHOP_WEBHOOK_SECRET=""

# Paddle Billing. Start in sandbox. Client token is public and injected into the browser build.
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_PRO_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
